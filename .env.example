# Google Analytics 4 (GA4) - Measurement ID
# Used for analytics, loaded only if the visitor accepts cookies.
# Example: VITE_GA4_ID=G-XXXXXXXXXX
VITE_GA4_ID=

# Cloudflare Turnstile - Site Key
# Used as a CAPTCHA on the contact form. If empty, the captcha is not shown
# and the form works without it (graceful degradation).
# Example: VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
VITE_TURNSTILE_SITE_KEY=
